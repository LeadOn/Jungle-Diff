    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/icon": "^2.5.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "subset-font": "^2.9.0",
